import assert from "node:assert/strict";
import React from "react";
import { renderToStaticMarkup } from "react-dom/server";
import { AnswerContent } from "../components/AnswerContent.tsx";
import { StudyFlow } from "../components/StudyFlow.tsx";
const content = "## A useful answer\n\nUse **cleanup** with `trap` [S1].\n\n- Check the exit code\n- Keep evidence\n\n```bash\necho '<script>unsafe</script>'\n```\n\n| Metric | Value |\n| --- | --- |\n| Recall | 0.8 |\n\n[unsafe](javascript:alert) and [Docs](https://example.com/docs)\n\n<script>alert('raw')</script>";
const html = renderToStaticMarkup(React.createElement(AnswerContent, { content, labels: ["S1"], messageIndex: 2 }));
assert.match(html, /<h3>A useful answer<\/h3>/);
assert.match(html, /<strong>cleanup<\/strong>/); assert.match(html, /<code>trap<\/code>/);
assert.match(html, /href="#ask-source-2-S1"/); assert.match(html, /<ul>/); assert.match(html, /<table>/);
assert.ok(html.includes("&lt;script&gt;")); assert.ok(!html.includes("<script>")); assert.ok(!html.includes('href="javascript:'));
assert.match(html, /href="https:\/\/example.com\/docs"/);
const literal = renderToStaticMarkup(React.createElement(AnswerContent, { content: "```text\n[S1]\n```\n\n[S999]", labels: ["S1"] }));
assert.ok(!literal.includes('class="ask-citation"'), "code and unvalidated labels are never citation links");
const flow = renderToStaticMarkup(React.createElement(StudyFlow, { row: 54, status: "In progress" }));
assert.match(flow, /\/plan\?row=54/); assert.match(flow, /Row 54/); assert.match(flow, /In progress/);
assert.ok(!flow.includes("completed"));
console.log("Answer formatting: safe HTML escaping, links, lists, code, tables, validated citations and real study context passed.");

// Mount the two interactive paths: citations reveal evidence, and Ship opens rather than toggles a proof form closed.
const { JSDOM } = await import("jsdom");
const dom = new JSDOM('<div id="root"></div><div class="artifact-recorder"><button aria-expanded="false">Record proof</button></div><details><li id="ask-source-2-S1" tabindex="-1">Evidence</li></details>', { url: "https://lumen.test" });
const globals = globalThis as unknown as Record<string, unknown>;
globals.window = dom.window; globals.self = dom.window; globals.document = dom.window.document; globals.IS_REACT_ACT_ENVIRONMENT = true;
globals.requestAnimationFrame = (callback: () => void) => { callback(); return 0; };
Object.defineProperty(globalThis, "navigator", { value: dom.window.navigator, configurable: true });
dom.window.HTMLElement.prototype.scrollIntoView = function() {};
Object.defineProperty(dom.window, "matchMedia", { value: () => ({ matches: false }) });
const runtimeErrors: unknown[] = [];
dom.window.addEventListener("error", (event) => { runtimeErrors.push(event.error); event.preventDefault(); });
const { createRoot } = await import("react-dom/client");
const root = createRoot(document.getElementById("root")!);
await React.act(async () => root.render(React.createElement(React.Fragment, {}, React.createElement(StudyFlow, { row: 1, status: "In progress" }), React.createElement(AnswerContent, { content: "Evidence [S1]", labels: ["S1"], messageIndex: 2 }))));
let proofOpens = 0;
const trigger = document.querySelector<HTMLButtonElement>('.artifact-recorder button')!;
trigger.onclick = () => { proofOpens++; trigger.setAttribute("aria-expanded", "true"); };
const ship = document.querySelector<HTMLButtonElement>('.study-flow-links button')!;
await React.act(async () => { ship.click(); });
assert.equal(proofOpens, 1); assert.equal(document.activeElement, trigger);
await React.act(async () => { ship.click(); }); assert.equal(proofOpens, 1, "Ship never closes an already open proof form");
await React.act(async () => document.querySelector<HTMLAnchorElement>('.ask-citation')!.click());
assert.equal(document.querySelector('details')!.open, true); assert.equal(document.activeElement?.id, "ask-source-2-S1");
assert.deepEqual(runtimeErrors, [], "interactive controls never throw browser errors");
await React.act(async () => root.unmount()); dom.window.close();
console.log("Mounted answer UX: citation reveal/focus and idempotent proof-form opening passed.");
