import assert from "node:assert/strict";
import { NextRequest } from "next/server";
import { authenticationConfigured, createSession, isValidSession, sessionCookie } from "./auth.ts";
import { proxy } from "../proxy.ts";
import { bodyWithinLimit, MAX_REQUEST_BYTES, mutationPolicy } from "./security.ts";
import { githubFetch, mapPool } from "./github.ts";
import { mergeReview, validReviewState } from "./review-sync.ts";

const env = { ...process.env };
const originalFetch = globalThis.fetch;
try {
  Object.assign(process.env, { NODE_ENV: "production", LUMEN_PASSWORD: "test-password-only", LUMEN_SESSION_SECRET: "test-signing-secret-at-least-32-characters", LUMEN_INTERNAL_API_KEY: "test-service-key" });
  assert.equal(authenticationConfigured(), true);
  const token = await createSession("rasul", process.env.LUMEN_PASSWORD!);
  assert.equal(await isValidSession(token, "rasul", process.env.LUMEN_PASSWORD!), true);
  const { POST: login } = await import("../app/api/auth/login/route.ts");
  const signedIn = await login(new Request("https://lumen.test/api/auth/login", { method: "POST", body: JSON.stringify({ username: "rasul", password: process.env.LUMEN_PASSWORD }) }));
  assert.equal(signedIn.status, 200);
  assert.match(signedIn.headers.get("set-cookie")!, /HttpOnly/);
  assert.match(signedIn.headers.get("set-cookie")!, /Secure/);
  const { POST: logout } = await import("../app/api/auth/logout/route.ts");
  assert.match((await logout()).headers.get("set-cookie")!, /Max-Age=0/);
  for (const bad of [token + ".extra", token.slice(0, -1), "a.b", "x".repeat(2049)]) assert.equal(await isValidSession(bad, "rasul", process.env.LUMEN_PASSWORD!), false);
  assert.equal(await isValidSession(token, "another-user", process.env.LUMEN_PASSWORD!), false);
  process.env.LUMEN_SESSION_SECRET += "rotated";
  assert.equal(await isValidSession(token, "rasul", process.env.LUMEN_PASSWORD!), false);
  process.env.LUMEN_SESSION_SECRET = "test-signing-secret-at-least-32-characters";
  const realNow = Date.now;
  Date.now = () => realNow() + 13 * 3_600_000;
  assert.equal(await isValidSession(token, "rasul", process.env.LUMEN_PASSWORD!), false);
  Date.now = realNow;
  const request = (path: string, init: RequestInit = {}) => new NextRequest(`https://lumen.test${path}`, init);
  let response = await proxy(request("/api/progress"));
  assert.equal(response.status, 401);
  assert.match(response.headers.get("cache-control")!, /no-store/);
  response = await proxy(request("/overview", { headers: { cookie: `${sessionCookie}=${token}` } }));
  assert.equal(response.status, 200);
  const csp = response.headers.get("content-security-policy")!;
  assert.match(csp, /nonce-/); assert.match(csp, /frame-ancestors 'none'/); assert.ok(!csp.split(";")[1].includes("unsafe-inline"));
  assert.ok(!csp.includes("unsafe-eval"));
  assert.notEqual((await proxy(request("/overview"))).headers.get("content-security-policy"), csp);
  assert.equal((await proxy(request("/api/progress", { headers: { "x-lumen-internal-key": "test-service-key" } }))).status, 401);
  assert.equal((await proxy(request("/api/ask", { method: "POST", headers: { "x-lumen-internal-key": "test-service-key", "content-type": "application/json" }, body: "{}" }))).status, 200);
  assert.equal((await proxy(request("/api/cron/market-scan"))).status, 401);
  const good = { method: "POST", headers: { origin: "https://lumen.test", "content-type": "application/json" }, body: "{}" };
  assert.equal(mutationPolicy(new Request("https://lumen.test/api/progress", good)), null);
  for (const origin of ["https://evil.test", "null", "https://lumen.test.evil.test"]) assert.equal(mutationPolicy(new Request("https://lumen.test/api/progress", { ...good, headers: { ...good.headers, origin } }))?.status, 403);
  assert.equal((await proxy(request("/api/progress", { ...good, headers: { ...good.headers, "sec-fetch-site": "cross-site" } }))).status, 403);
  assert.equal(mutationPolicy(new Request("https://lumen.test/api/progress", { ...good, headers: { origin: "https://lumen.test", "content-type": "text/plain" } }))?.status, 415);
  assert.equal(await bodyWithinLimit(new Request("https://lumen.test", { method: "POST", body: "x".repeat(MAX_REQUEST_BYTES + 1) })), false);
  delete process.env.LUMEN_PASSWORD;
  assert.equal((await proxy(request("/api/progress"))).status, 503);
  assert.equal((await proxy(request("/healthz"))).status, 200);
  process.env.LUMEN_PASSWORD = "test-password-only"; delete process.env.LUMEN_SESSION_SECRET;
  assert.equal(authenticationConfigured(), false);
  assert.equal((await proxy(request("/overview", { headers: { cookie: `${sessionCookie}=${token}` } }))).status, 503);

  let calls = 0;
  globalThis.fetch = async (_url, init) => { calls++; assert.ok(init?.signal); return calls < 3 ? Response.json({}, { status: 503 }) : Response.json({ ok: true }); };
  assert.equal((await githubFetch("https://api.github.com/test")).status, 200); assert.equal(calls, 3);
  calls = 0;
  globalThis.fetch = async () => { calls++; return new Response(null, { status: 429, headers: { "retry-after": "60" } }); };
  assert.equal((await githubFetch("https://api.github.com/test")).status, 429); assert.equal(calls, 1);
  const payload = { branch: "main", content: Buffer.from("same content").toString("base64") };
  globalThis.fetch = async (_url, init) => init?.method === "PUT" ? Response.json({}, { status: 409 }) : Response.json({ content: payload.content, sha: "a".repeat(40) });
  assert.equal((await githubFetch("https://api.github.com/test", { method: "PUT", body: JSON.stringify(payload) })).status, 200);
  globalThis.fetch = async (_url, init) => init?.method === "PUT" ? Response.json({}, { status: 409 }) : Response.json({ content: "different" });
  assert.equal((await githubFetch("https://api.github.com/test", { method: "PUT", body: JSON.stringify(payload) })).status, 409);
  let active = 0, max = 0;
  const result = await mapPool(Array.from({ length: 20 }, (_, i) => i), 3, async (i) => { active++; max = Math.max(max, active); await new Promise((r) => setTimeout(r, 2)); active--; return i; });
  assert.equal(max, 3); assert.deepEqual(result, Array.from({ length: 20 }, (_, i) => i));
  assert.equal(validReviewState({ k: { rung: 1, due: "2026-02-30", seen: 1 } }), false);
  assert.equal(validReviewState([]), false);
  assert.equal(validReviewState({ k: { rung: 10, due: "2026-02-01", seen: 1 } }), false);
  const local = { k: { rung: 1, due: "2026-11-05", seen: 2 } }, remote = { k: { rung: 2, due: "2026-11-06", seen: 3 } };
  assert.deepEqual(mergeReview(local, remote), remote);
  console.log("Security: session tampering/expiry/rotation, fail-closed routes, scoped service access, CSRF, CSP, body limits, bounded GitHub retries/conflict verification and review validation passed.");
} finally { globalThis.fetch = originalFetch; process.env = env; }
