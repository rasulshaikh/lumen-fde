    "test:brief": "npx tsx lib/companion/brief.test.mts",
    "test:session": "npx tsx lib/companion/session.test.mts",
    "test:external": "npx tsx lib/external/brief.test.mts",
    "test:paths": "npx tsx lib/paths.test.mts",
    "test:hero": "npx tsx lib/hero.test.mts",
    "test:paper": "npx tsx lib/paper.test.mts",
